{
    "name": "Sample_Synapse_Notebook",
    "properties": {
        "folder": {
            "name": "Samples"
        },
        "nbformat": 4,
        "nbformat_minor": 2,
        "bigDataPool": {
            "referenceName": "SamplePool",
            "type": "BigDataPoolReference"
        },
        "sessionProperties": {
            "driverMemory": "28g",
            "driverCores": 4,
            "executorMemory": "28g",
            "executorCores": 4,
            "numExecutors": 2,
            "runAsWorkspaceSystemIdentity": true,
            "conf": {
                "spark.dynamicAllocation.enabled": "false"
            }
        },
        "metadata": {
            "saveOutput": true,
            "enableDebugMode": false,
            "kernelspec": {
                "name": "synapse_pyspark",
                "display_name": "Synapse PySpark"
            },
            "language_info": {
                "name": "python"
            },
            "sessionKeepAliveTimeout": 30
        },
        "cells": [
            {
                "cell_type": "code",
                "metadata": {
                    "tags": ["parameters"]
                },
                "source": ["run_date = None\n", "republish = False"],
                "execution_count": 7
            },
            {
                "cell_type": "markdown",
                "metadata": {
                    "nteract": {
                        "transient": {
                            "deleting": false
                        }
                    }
                },
                "source": ["#### Documentation\n", "\n", "Sample fixture used by the notebook viewer round-trip test."]
            },
            {
                "cell_type": "code",
                "metadata": {
                    "jupyter": {
                        "source_hidden": false,
                        "outputs_hidden": false
                    }
                },
                "source": ["%%sql\r\n", "SELECT TOP 10 *\r\n", "FROM sample.table"],
                "execution_count": 8
            },
            {
                "cell_type": "code",
                "metadata": {},
                "source": [
                    "df = spark.read.parquet(source_path)\n",
                    "df.write.mode(\"overwrite\").parquet(target_path)"
                ],
                "execution_count": null
            }
        ]
    }
}
